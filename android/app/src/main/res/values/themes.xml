<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.EBPMedical" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/ebp_ink</item>
        <item name="colorPrimaryVariant">@color/ebp_ink</item>
        <item name="colorOnPrimary">@color/ebp_paper</item>
        <item name="colorSecondary">@color/ebp_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/ebp_ink</item>
        <item name="android:windowBackground">@color/ebp_paper</item>
        <item name="actionBarStyle">@style/EBPActionBar</item>
    </style>

    <style name="EBPActionBar" parent="Widget.AppCompat.ActionBar">
        <item name="background">@color/ebp_ink</item>
        <item name="titleTextStyle">@style/EBPActionBarTitle</item>
    </style>

    <style name="EBPActionBarTitle" parent="TextAppearance.AppCompat.Widget.ActionBar.Title">
        <item name="android:textColor">@color/ebp_paper</item>
        <item name="android:textSize">17sp</item>
    </style>
</resources>
